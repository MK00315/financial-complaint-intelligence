table Complaints
	lineageTag: 8b7f855e-7343-4944-ae66-30f12084397c

	measure 'Total Complaints' = SUM('Complaints'[Complaint Count])
		formatString: #,##0
		lineageTag: 468724bf-203f-4e22-9703-ada31f7ab4cb

	measure 'Written Complaints' = SUM('Complaints'[Narrative Count])
		formatString: #,##0
		lineageTag: 31c10570-c0fb-4151-915a-3f35ad2a46ad

	measure 'Narrative Coverage' = DIVIDE([Written Complaints], [Total Complaints])
		formatString: 0.00%
		lineageTag: 281476a4-aef9-4875-98d8-9676efe59985

	measure 'Timely Response Rate' = DIVIDE(SUM('Complaints'[Timely Count]), SUM('Complaints'[Known Timeliness Count]))
		formatString: 0.00%
		lineageTag: 65783f95-e885-4076-8e6e-46ad6086899d

	measure 'Products in Selection' = DISTINCTCOUNT('Complaints'[Product ID])
		formatString: 0
		lineageTag: e63b587a-2562-45c5-a103-ec7d14e865ee

	measure 'Issues in Selection' = DISTINCTCOUNT('Complaints'[Issue ID])
		formatString: 0
		lineageTag: 1790936f-be4d-458b-9070-c2c7235c0d7b

	measure 'Reporting Days' = DISTINCTCOUNT('Complaints'[Date])
		formatString: 0
		lineageTag: 719c4427-1875-4f87-9db4-bf5cb65956b6

	measure 'Average Daily Complaints' = DIVIDE([Total Complaints], [Reporting Days])
		formatString: #,##0
		lineageTag: 5e8b6619-ac67-446f-9e78-d59e5eeec775

	measure 'Share of Selected Complaints' = DIVIDE([Total Complaints], CALCULATE([Total Complaints], ALLSELECTED('Products'), ALLSELECTED('Issues')))
		formatString: 0.0%
		lineageTag: eb1eb9a9-364f-43f3-ae0b-94bde6a6dadd

	column Date
		dataType: dateTime
		formatString: dd MMM yyyy
		lineageTag: df4492e2-3853-4c30-8952-34a2696118b1
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Product ID'
		dataType: int64
		isHidden
		lineageTag: 28742bc8-cfb8-4bd3-b463-0308aba92943
		summarizeBy: none
		sourceColumn: Product ID

	column 'Issue ID'
		dataType: int64
		isHidden
		lineageTag: e8092454-6e55-445d-af81-6bc83c2332bf
		summarizeBy: none
		sourceColumn: Issue ID

	column 'Complaint Count'
		dataType: int64
		lineageTag: 38e3990e-9545-4f9d-992b-627b3f68ea06
		summarizeBy: none
		sourceColumn: Complaint Count

	column 'Narrative Count'
		dataType: int64
		lineageTag: 171c94e6-bed7-42be-9ac5-3eb5e72cd6c6
		summarizeBy: none
		sourceColumn: Narrative Count

	column 'Timely Count'
		dataType: int64
		lineageTag: 0806eb86-c47b-474b-8340-cc1ef6870ec4
		summarizeBy: none
		sourceColumn: Timely Count

	column 'Known Timeliness Count'
		dataType: int64
		lineageTag: 09843593-a98f-4914-9161-63eb7fff9706
		summarizeBy: none
		sourceColumn: Known Timeliness Count

	partition Complaints = m
		mode: import
		source =
				let
				    Snapshot = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
				    Rows = Table.FromRows(Snapshot, {"Date", "Product ID", "Issue ID", "Complaint Count", "Narrative Count", "Timely Count", "Known Timeliness Count"}),
				    Typed = Table.TransformColumnTypes(Rows, {{"Date", type date}, {"Product ID", Int64.Type}, {"Issue ID", Int64.Type}, {"Complaint Count", Int64.Type}, {"Narrative Count", Int64.Type}, {"Timely Count", Int64.Type}, {"Known Timeliness Count", Int64.Type}}, "en-US")
				in
				    Typed
