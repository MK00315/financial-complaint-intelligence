table 'Signal Summary'
	lineageTag: b6d363ae-9bae-4a19-8221-41bd3f5ebb86

	measure 'Signal Archive Complaints' = VAR w = [Selected Signal Week] RETURN CALCULATE(MAX('Signal Summary'[Archive Total]), 'Signal Summary'[Week] = w)
		formatString: #,##0
		lineageTag: 14b0357f-43b6-4997-99f6-3c2b5d8fc126

	measure 'Baseline Weekly Complaints' = VAR w = [Selected Signal Week] RETURN CALCULATE(MAX('Signal Summary'[Baseline Archive Mean]), 'Signal Summary'[Week] = w)
		formatString: #,##0.0
		lineageTag: 0b865188-96b8-4142-ad8b-c1394bc719c5

	measure 'Qualifying Signals' = VAR w = [Selected Signal Week] RETURN CALCULATE(MAX('Signal Summary'[Flags]), 'Signal Summary'[Week] = w)
		formatString: 0
		lineageTag: 57dba731-c623-4ab4-a21d-ae930cb3a65e

	measure 'Issue Pairs Assessed' = VAR w = [Selected Signal Week] RETURN CALCULATE(MAX('Signal Summary'[Issue Pairs]), 'Signal Summary'[Week] = w)
		formatString: 0
		lineageTag: 5df67adc-beb1-4ad8-879f-dd4e00168a3f

