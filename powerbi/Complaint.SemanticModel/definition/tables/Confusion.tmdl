table Confusion
	lineageTag: d82e2bf8-b928-45cd-958c-1dfc846bd3a7

	measure 'Confusion Cases' = SUM('Confusion'[Cases])
		formatString: #,##0
		lineageTag: c769ad83-c80e-4deb-bbfb-bf6756ed4e3f

	measure 'Confusion Row Share' = DIVIDE([Confusion Cases], CALCULATE([Confusion Cases], REMOVEFILTERS('Confusion'[Predicted], 'Confusion'[Predicted Short], 'Confusion'[Predicted Code])))
		formatString: 0.0%
		lineageTag: 946b2981-db79-4866-95b3-57cd54667022

	column Actual
		dataType: string
		lineageTag: 56299271-7d36-4aba-bcba-30a47e09ae70
		summarizeBy: none
		sourceColumn: Actual

	column 'Actual Short'
		dataType: string
		lineageTag: 73b6afe7-abd0-4570-afb2-84c690e28cb8
		summarizeBy: none
		sourceColumn: Actual Short

	column Predicted
		dataType: string
		lineageTag: a224f27e-4ff4-4ca0-8a93-1058be478619
		summarizeBy: none
		sourceColumn: Predicted

	column 'Predicted Short'
		dataType: string
		lineageTag: 01915ccd-5100-4d5e-974a-d79ab999c07a
		summarizeBy: none
		sourceColumn: Predicted Short

	column Cases
		dataType: int64
		lineageTag: a0f52018-7a38-4064-bd49-702426215e5e
		summarizeBy: none
		sourceColumn: Cases

	column 'Predicted Code'
		dataType: string
		lineageTag: 95934582-9358-4327-b80d-4fbb2a236f75
		summarizeBy: none
		sourceColumn: Predicted Code

	partition Confusion = m
		mode: import
		source =
				let
				    Snapshot = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
				    Rows = Table.FromRows(Snapshot, {"Actual", "Actual Short", "Predicted", "Predicted Short", "Cases", "Predicted Code"}),
				    Typed = Table.TransformColumnTypes(Rows, {{"Actual", type text}, {"Actual Short", type text}, {"Predicted", type text}, {"Predicted Short", type text}, {"Cases", Int64.Type}, {"Predicted Code", type text}}, "en-US")
				in
				    Typed
