table 'Signal Details'
	lineageTag: fb692c77-8dbd-40c5-a877-129a8eabeec3

	measure 'Issue Week Complaints' = VAR w = [Selected Signal Week] RETURN CALCULATE(SUM('Signal Details'[Current Count]), 'Signal Details'[Week] = w)
		formatString: #,##0
		lineageTag: 3a35fd9b-64cc-4ad0-8bdf-ede8ea8beef3

	measure 'Issue Baseline Mean' = VAR w = [Selected Signal Week] RETURN CALCULATE(SUM('Signal Details'[Baseline Mean]), 'Signal Details'[Week] = w)
		formatString: #,##0.0
		lineageTag: 3639340e-5e5a-4392-ba04-22da51b55fd3

	measure 'Issue Volume Multiple' = VAR w = [Selected Signal Week] RETURN CALCULATE(MAX('Signal Details'[Volume Multiple]), 'Signal Details'[Week] = w)
		formatString: 0.00x
		lineageTag: 1b57e1d5-1d40-4fd0-8155-9fded2bc708e

	measure 'Issue Share Growth pp' = VAR w = [Selected Signal Week] RETURN CALCULATE(MAX('Signal Details'[Share Growth pp]), 'Signal Details'[Week] = w)
		formatString: +0.00;-0.00;0.00
		lineageTag: f9a1ca09-5eec-43f9-aa21-f695e3e2834a

	measure 'Issue Flag' = VAR w = [Selected Signal Week] RETURN CALCULATE(MAX('Signal Details'[Flag]), 'Signal Details'[Week] = w)
		formatString: 0
		lineageTag: 637f4e30-f095-40ed-95d2-c177c479fc81

