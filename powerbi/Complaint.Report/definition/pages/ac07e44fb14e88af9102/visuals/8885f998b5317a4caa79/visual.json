                      "color": "#16324F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "All four conditions must hold:",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#16324F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#16324F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "1. At least 30 complaints in the current week.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#16324F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "2. Baseline weekly mean of at least 5.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#16324F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "3. Volume at least 1.5 times the baseline.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#16324F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "4. Share rises by at least 0.5 percentage points.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#16324F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#16324F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "No issue meets every condition in any of the three evaluable weeks.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#16324F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#16324F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "These are descriptive screening rules, not statistical significance tests.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
