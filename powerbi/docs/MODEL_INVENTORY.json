  "Complaints": {
    "columns": [
      [
        "Date",
        "dateTime"
      ],
      [
        "Product ID",
        "int64"
      ],
      [
        "Issue ID",
        "int64"
      ],
      [
        "Complaint Count",
        "int64"
      ],
      [
        "Narrative Count",
        "int64"
      ],
      [
        "Timely Count",
        "int64"
      ],
      [
        "Known Timeliness Count",
        "int64"
      ]
    ],
    "rows": 5024,
    "measures": [
      [
        "Total Complaints",
        "SUM('Complaints'[Complaint Count])",
        "#,##0"
      ],
      [
        "Written Complaints",
        "SUM('Complaints'[Narrative Count])",
        "#,##0"
      ],
      [
        "Narrative Coverage",
        "DIVIDE([Written Complaints], [Total Complaints])",
        "0.00%"
      ],
      [
        "Timely Response Rate",
        "DIVIDE(SUM('Complaints'[Timely Count]), SUM('Complaints'[Known Timeliness Count]))",
        "0.00%"
      ],
      [
        "Products in Selection",
        "DISTINCTCOUNT('Complaints'[Product ID])",
        "0"
      ],
      [
        "Issues in Selection",
        "DISTINCTCOUNT('Complaints'[Issue ID])",
        "0"
      ],
      [
        "Reporting Days",
        "DISTINCTCOUNT('Complaints'[Date])",
        "0"
      ],
      [
        "Average Daily Complaints",
        "DIVIDE([Total Complaints], [Reporting Days])",
        "#,##0"
      ],
      [
        "Share of Selected Complaints",
        "DIVIDE([Total Complaints], CALCULATE([Total Complaints], ALLSELECTED('Products'), ALLSELECTED('Issues')))",
        "0.0%"
      ]
    ]
  },
